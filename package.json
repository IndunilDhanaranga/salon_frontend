{
  "name": "salon-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "dev:lan": "next dev --webpack --hostname 0.0.0.0",
    "format": "prettier --write src tests next.config.ts tsconfig.json package.json README.md DESIGN.md docs",
    "format:check": "prettier --check src tests next.config.ts tsconfig.json package.json README.md DESIGN.md docs"
  },
  "dependencies": {
    "@types/web-push": "^3.6.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
